# Copy to .env.local and fill in. Never commit .env.local.

# Claude API. Required in production: the server refuses to start without it.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_MAX_CONCURRENCY=8
# low | medium | high (default low). Not named CLAUDE_EFFORT: Claude Code sets that variable
# for processes it starts, which would override .env.local.
CLAUDE_ANALYZE_EFFORT=low
# Development only: 1 = answer from fixtures/claude/ instead of calling Claude. Also the
# default in development when ANTHROPIC_API_KEY is empty. Not allowed in production.
CLAUDE_MOCK=

# LanguageTool, only reachable from this machine (127.0.0.1: it listens on IPv4 only)
LT_URL=http://127.0.0.1:8081

# Shared login
APP_USERNAME=
# Generate with: npm run hash-password
APP_PASSWORD_HASH_B64=
# Random string, at least 32 characters. Example:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# Increase to log out every device (e.g. after changing the password), then restart the app.
SESSION_VERSION=1

# SQLite file (dictionary + daily usage numbers only)
DATABASE_PATH=./data/app.db
