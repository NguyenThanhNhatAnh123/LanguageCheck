# Copy to .env.local and fill in. Never commit .env.local.

# Claude API (used from Giai đoạn 2)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_MAX_CONCURRENCY=8

# LanguageTool, only reachable from this machine
LT_URL=http://localhost:8081

# Shared login
APP_USERNAME=
# Generate with: npm run hash-password
APP_PASSWORD_HASH_B64=
# Random string, at least 32 characters. Example:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# Increase to log out every device (e.g. after changing the password), then restart the app.
SESSION_VERSION=1

# SQLite file (dictionary + daily usage numbers only)
DATABASE_PATH=./data/app.db
